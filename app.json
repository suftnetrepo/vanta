{
  "expo": {
    "name": "Vanta",
    "slug": "vanta",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vanta.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Vanta needs camera access to scan documents.",
        "NSPhotoLibraryUsageDescription": "Vanta needs photo library access to import documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111"
      },
      "package": "com.vanta.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "fonts": [
      "./assets/fonts/Inter-Regular.ttf",
      "./assets/fonts/Inter-Medium.ttf",
      "./assets/fonts/Inter-SemiBold.ttf",
      "./assets/fonts/Inter-Bold.ttf"
    ],
    "plugins": [
       "expo-router"
    ]
  }
}
